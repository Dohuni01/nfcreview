# 이 파일을 복사해서 .env를 만들고 값을 채우세요:  cp .env.example .env && nano .env
# .env는 절대 GitHub에 올리지 마세요 (.gitignore에 들어 있어요)

# 내 도메인 (https:// 없이)
DOMAIN=review.example.com

# 실행할 앱 이미지
#  9부 (서버에서 직접 빌드):  nfcreview-app:local
# 10부 (자동 배포) 이후:      ghcr.io/깃허브아이디소문자/nfcreview:latest
APP_IMAGE=nfcreview-app:local

# DB 비밀번호: 서버에서 openssl rand -base64 24 로 만든 값을 붙여넣기
# 주의: DB가 처음 만들어질 때만 적용돼요. 나중에 바꾸면 기존 DB에는 반영되지 않아요.
DB_PASSWORD=change-me

# 관리자 로그인 (비밀번호 8자 이상, 로컬용 admin1234 금지)
ADMIN_USERNAME=dohun
ADMIN_PASSWORD=change-me-please
